      <div>
                <a href="#" class="footer-logo">
          <Image src={logo} alt="Castro & Monje Asociados" width={220} height={133} />
        </a>

        <p class="footer-text">
          Bufete de Abogados en La Paz, Bolivia.<br />Integridad,
          transparencia y resultados en la defensa de sus derechos.
        </p>
      </div>
      <div>
        <h4>Contacto Local</h4>
        <ul class="footer-links">
          <li><a href="tel:+59170557088">Telf: +591 70557088</a></li>
          <li>
            <a
              href="https://wa.me/59170557088"
              target="_blank"
              rel="noopener"
              >Chat por WhatsApp</a
            >
          </li>
          <li>
            <span class="footer-muted">Edif. HANSA, Piso 15, Of. 1-2</span>
          </li>
          <li>
            <span class="footer-muted">Zona Central, La Paz, Bolivia</span>
          </li>
