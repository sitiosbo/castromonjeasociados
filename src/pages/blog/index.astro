---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

function formatDate(date: Date): string {
  return date.toLocaleDateString('es-BO', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<BlogLayout
  title="Blog | Castro & Monje Asociados"
  description="Artículos y análisis sobre derecho en Bolivia. Información legal actualizada por los abogados de Castro & Monje Asociados en La Paz."
  canonicalPath="/blog/"
>
  <section class="hero-subpage">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/">Inicio</a>
        <span class="breadcrumb-sep">&rsaquo;</span>
        <span class="breadcrumb-current">Blog</span>
      </nav>
      <h1 class="display-md">Blog Legal</h1>
      <p class="section-subtitle">
        Artículos, análisis y novedades del mundo jurídico boliviano.
      </p>
    </div>
  </section>

  <section class="blog-listing">
    <div class="container">
      <div class="blog-grid">
        {posts.map((post) => (
          <a href={`/blog/${post.id}/`} class="card blog-card">
            {post.data.image && (
              <img
                src={post.data.image}
                alt={post.data.title}
                class="blog-card-img"
                loading="lazy"
              />
            )}
            <div class="blog-card-body">
              <time class="blog-card-date" datetime={post.data.date.toISOString()}>
                {formatDate(post.data.date)}
              </time>
              <h2 class="blog-card-title">{post.data.title}</h2>
              <p class="blog-card-desc">{post.data.description}</p>
              {post.data.tags && (
                <div class="blog-card-tags">
                  {post.data.tags.map((tag) => (
                    <span class="tag-badge">{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BlogLayout>
